create function pg_temp.seed_reservation(
  p_id uuid,
  p_starts_at timestamptz default '2035-04-12 15:00:00+00',
  p_type reservation_type default 'rental',
  p_status reservation_status default 'scheduled'
) returns void
language plpgsql as $$
begin
  alter table reservations disable trigger reservations_stamp_audit;
  insert into reservations
    (id, customer_name, people_count, type, starts_at, duration_minutes, status, cancellation_reason, created_by, updated_by, updated_at)
  values
    (p_id, 'RES18 Customer', 2, p_type, p_starts_at, 60, p_status,
     case when p_status = 'cancelled' then 'RES18 reason' end,
     'e3180000-0000-4000-8000-000000000001', 'e3180000-0000-4000-8000-000000000001',
     '2030-01-01 12:00:00.123456+00');
  alter table reservations enable trigger reservations_stamp_audit;
end;
$$;

create function pg_temp.reservation_payload(
  p_id uuid,
  p_changes jsonb default '{}'
) returns jsonb
language sql stable as $$
  select jsonb_build_object(
    'reservation_id', reservation.id,
    'people_count', reservation.people_count,
    'time', to_char(reservation.starts_at at time zone 'America/Costa_Rica', 'HH24:MI'),
    'duration_minutes', reservation.duration_minutes,
    'expected_updated_at', reservation.updated_at,
    'category_id', item.category_id,
    'quantity', item.quantity,
    'unit_id', item.unit_id
  ) || p_changes
  from reservations as reservation
  left join lateral (
    select target.category_id, target.quantity, target.unit_id
    from reservation_items as target
    where target.reservation_id = reservation.id
      and target.extra_id is null and target.dispatch_id is null
    order by target.id limit 1
  ) as item on true
  where reservation.id = p_id;
$$;
