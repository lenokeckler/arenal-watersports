create function pg_temp.reading(p_item integer, p_fuel jsonb default null, p_usage jsonb default null)
returns jsonb language sql immutable as $$
  select jsonb_strip_nulls(jsonb_build_object(
    'item_id', 'e3300000-0000-4000-8000-000000000' || p_item, 'fuel_in', p_fuel, 'usage_in', p_usage))
$$;

create function pg_temp.record(p_readings jsonb, p_postponement uuid default 'e3300000-0000-4000-8000-000000000401')
returns void language sql as $$
  select private.record_postponement_readings('e3300000-0000-4000-8000-000000000301', p_postponement, p_readings)
$$;

create function pg_temp.release(p_reservation uuid default 'e3300000-0000-4000-8000-000000000301', p_readings jsonb default '[]',
  p_postponement uuid default 'e3300000-0000-4000-8000-000000000401')
returns void language sql as $$
  select private.release_dispatched_reservation(p_reservation, p_postponement, p_readings)
$$;
