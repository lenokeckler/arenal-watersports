# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/playwright-artifacts/
/playwright-report/
/playwright-screenshots/

# A personal story tracker is optional and lives outside the repository if a
# developer keeps one. Any tracker committed under this name would collide
# with every teammate's on merge. The shared state of a story lives in Jira,
# synced automatically by .github/workflows/jira-sync.yml.
docs/proyecto/PROGRESO.md

# .claude/ is per developer, except the subagents: .claude/agents/*.md is the
# committed, cross-tool source every teammate's harness reads.
.claude/*
!.claude/agents/
.claude/settings.local.json

# Working artifacts for the agent pipeline (plans, scratch notes) never ship.
.agents/tmp/*
!.agents/tmp/.gitkeep

docs/referencia/stitch/
.mcp.json

# Personal, ignored execution route for local calendar previews.
/app/access/local-preview/
/playwright-screenshots/local-calendar-preview/
/debug.log
/image.png
