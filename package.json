{
  "name": "arenal-watersports",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium-mobile --project=chromium-desktop --project=chromium-mobile-admin-recovery",
    "test:e2e:ui": "playwright test --project=chromium-mobile --project=chromium-desktop --project=chromium-mobile-admin-recovery --ui",
    "test:e2e:headed": "playwright test --project=chromium-mobile --project=chromium-desktop --project=chromium-mobile-admin-recovery --headed",
    "test:e2e:screenshots": "playwright test --project=chromium-mobile-screenshots --project=chromium-desktop-screenshots --project=chromium-mobile-admin-screenshots --project=chromium-desktop-admin-screenshots",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase db reset --no-seed && supabase test db",
    "db:types": "supabase gen types typescript --local > app/types/database.types.ts",
    "story": "node scripts/story.mjs",
    "changelog": "node scripts/changelog.mjs",
    "changelog:check": "node scripts/changelog.mjs --check",
    "stories:jira": "node scripts/stories-to-jira.mjs",
    "agents:sync": "node scripts/sync-agents.mjs",
    "agents:check": "node scripts/sync-agents.mjs --check"
  },
  "dependencies": {
    "@next/third-parties": "^16.1.6",
    "@reduxjs/toolkit": "^2.11.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "country-codes-flags-phone-codes": "^1.1.1",
    "next": "16.1.6",
    "nodemailer": "10.0.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20.19.33",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
